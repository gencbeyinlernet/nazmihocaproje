  },
  {
    "scene": 4,
    "speaker": "Murat Öğretmen",
    "file": "04-murat-ogretmen.mp3",
    "durationSeconds": 4.440816,
    "text": "Bir iğnenin dahi mutlaka bir ustası, bir yapanı vardır.",
    "voiceName": "George - Warm, Captivating Storyteller",
    "provider": "ElevenLabs",
    "model": "eleven_v4",
    "sha256": "2f87e4027b25ae2ab8cee8535736739e2020562f43519ed9f06088eda8934512"
  },
  {
    "scene": 5,
    "speaker": "Murat Öğretmen",
    "file": "05-murat-ogretmen.mp3",
    "durationSeconds": 4.597551,
    "text": "Masaların, sıraların, binaların, arabaların, trenlerin,",
