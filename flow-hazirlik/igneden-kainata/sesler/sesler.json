  },
  {
    "scene": 2,
    "speaker": "Ali",
    "file": "02-ali.mp3",
    "durationSeconds": 2.429388,
    "text": "Aslında Allah diye bir şey yoktur.",
    "voiceName": "Liam - Energetic, Social Media Creator",
    "provider": "ElevenLabs",
    "model": "eleven_v4",
    "sha256": "b29dcc3c0a6cfc570d5bbe0816a111f50e26bf724ee450cadb5fd357e84aa131"
  },
  {
    "scene": 3,
    "speaker": "Murat Öğretmen",
    "file": "03-murat-ogretmen.mp3",
    "durationSeconds": 2.925714,
    "text": "Düşünce ürünü şöyle mi oluyor? Bakıyoruz.",
    "voiceName": "George - Warm, Captivating Storyteller",
    "provider": "ElevenLabs",
    "model": "eleven_v4",
