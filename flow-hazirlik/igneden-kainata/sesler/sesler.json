    "model": "eleven_v4",
    "sha256": "eda435eb9ae66fc532f11d8b43071bbfd36095733ba47222e992dabc0234ea13"
  },
  {
    "scene": 10,
    "speaker": "Ece",
    "file": "10-ece.mp3",
    "durationSeconds": 3.474286,
    "text": "Evet. Ancak aksini iddia edenler de var.",
