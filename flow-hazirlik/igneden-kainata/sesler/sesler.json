    "model": "eleven_v4",
    "sha256": "d72657ad3648f550b4b3f2d54268bcd44b8c0ae0d8007cae5773faae0554ca56"
  },
  {
    "scene": 11,
    "speaker": "Murat Öğretmen",
    "file": "11-murat-ogretmen.mp3",
    "durationSeconds": 2.115918,
    "text": "Aksi ne şekilde iddia edilir?",
