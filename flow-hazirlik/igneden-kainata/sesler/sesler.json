    "provider": "ElevenLabs",
    "model": "eleven_v4",
    "sha256": "310603725e2f28136ad56a39709628c9880aa2fb097fbdb80d095c465c85202f"
  },
  {
    "scene": 6,
    "speaker": "Murat Öğretmen",
    "file": "06-murat-ogretmen.mp3",
    "durationSeconds": 4.754286,
    "text": "uçakların, robotların mutlaka bir ustası, bir yapanı var.",
    "voiceName": "George - Warm, Captivating Storyteller",
    "provider": "ElevenLabs",
    "model": "eleven_v4",
    "sha256": "9c2876deee76cfd896861cbbf9cf19171091f49ed7665aa143c43942e1308e00"
  },
  {
    "scene": 7,
    "speaker": "Murat Öğretmen",
    "file": "07-murat-ogretmen.mp3",
    "durationSeconds": 4.04898,
    "text": "İnsan ve kainat bunlardan daha mükemmel varlıklardır.",
    "voiceName": "George - Warm, Captivating Storyteller",
    "provider": "ElevenLabs",
    "model": "eleven_v4",
    "sha256": "a546b4a6f6113c088a36b5937e6f705845a6b7bcd9c038b6ad39a568bcf17974"
  },
  {
    "scene": 8,
    "speaker": "Murat Öğretmen",
    "file": "08-murat-ogretmen.mp3",
    "durationSeconds": 4.989388,
    "text": "Dolayısıyla onların da bir ustası, bir yapanı, bir yaratanı vardır.",
    "voiceName": "George - Warm, Captivating Storyteller",
    "provider": "ElevenLabs",
    "model": "eleven_v4",
    "sha256": "dcb20d06674302ccf01306b4ef8d8f9f620bfda39ec9fca857bfbadfa3617d3a"
