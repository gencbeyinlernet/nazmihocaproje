    {
      "number": 8,
      "image": "08-gorsel.jpg",
      "audioFile": "sesler/08-murat-ogretmen.mp3",
      "speaker": "Murat Öğretmen",
      "text": "Dolayısıyla onların da bir ustası, bir yapanı, bir yaratanı vardır.",
      "startFrame": 855,
      "endFrame": 1010,
      "startSeconds": 28.5,
      "endSeconds": 33.666667,
      "durationSeconds": 5.166667,
      "decodedAudioSeconds": 4.96,
      "audioStartSeconds": 28.56,
