      "audioSha256": "dcb20d06674302ccf01306b4ef8d8f9f620bfda39ec9fca857bfbadfa3617d3a"
    },
    {
      "number": 9,
      "image": "09-gorsel.jpg",
      "audioFile": "sesler/09-murat-ogretmen.mp3",
      "speaker": "Murat Öğretmen",
      "text": "O da Allah'tır. Allah'ın düşünce ürünü olması bu şekilde mi oluyor?",
      "startFrame": 1010,
      "endFrame": 1163,
      "startSeconds": 33.666667,
      "endSeconds": 38.766667,
      "durationSeconds": 5.1,
