      "audioSha256": "d9ebffda7a1bcab17381f0f92004acacb1fa66e3175713dd7438ce5341ee6e6c"
    },
    {
      "number": 2,
      "image": "02-gorsel.jpg",
      "audioFile": "sesler/02-ali.mp3",
      "speaker": "Ali",
