      "audioSha256": "b29dcc3c0a6cfc570d5bbe0816a111f50e26bf724ee450cadb5fd357e84aa131"
    },
    {
      "number": 3,
      "image": "03-gorsel.jpg",
      "audioFile": "sesler/03-murat-ogretmen.mp3",
      "speaker": "Murat Öğretmen",
      "text": "Düşünce ürünü şöyle mi oluyor? Bakıyoruz.",
      "startFrame": 207,
