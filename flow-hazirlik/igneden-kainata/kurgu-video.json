      "endFrame": 438,
      "startSeconds": 10.0,
      "endSeconds": 14.6,
      "durationSeconds": 4.6,
      "decodedAudioSeconds": 4.4,
      "audioStartSeconds": 10.06,
      "imageSha256": "160d0f2b22a7ef34fcc6c961ab7c83f33ef3bb06d8990a272f84de55d2578dca",
      "audioSha256": "2f87e4027b25ae2ab8cee8535736739e2020562f43519ed9f06088eda8934512"
    },
    {
      "number": 5,
      "image": "05-gorsel.jpg",
      "audioFile": "sesler/05-murat-ogretmen.mp3",
      "speaker": "Murat Öğretmen",
      "text": "Masaların, sıraların, binaların, arabaların, trenlerin,",
      "startFrame": 438,
      "endFrame": 581,
      "startSeconds": 14.6,
      "endSeconds": 19.366667,
      "durationSeconds": 4.766667,
      "decodedAudioSeconds": 4.56,
