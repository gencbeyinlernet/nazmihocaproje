      "audioSha256": "d01d22e64ab1cdf207708584a98ed1daee5bf43b3d1bf03345bf4f358030b26f"
    },
    {
      "number": 4,
      "image": "04-gorsel.jpg",
      "audioFile": "sesler/04-murat-ogretmen.mp3",
      "speaker": "Murat Öğretmen",
      "text": "Bir iğnenin dahi mutlaka bir ustası, bir yapanı vardır.",
