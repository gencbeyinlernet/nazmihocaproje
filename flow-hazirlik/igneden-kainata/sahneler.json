      "flowPromptFile": "06-flow.txt"
    },
    {
      "number": 7,
      "speaker": "Anlatıcı",
      "text": "kanıt değildir. Evreni anlamak, gözlem ve araştırma gerektirir.",
      "chapter": "Benzetmeyi doğru anlamak",
      "paragraph": 4,
      "imageFile": "gorseller/07-gorsel.jpg",
      "image": "gorseller/07-gorsel.jpg",
