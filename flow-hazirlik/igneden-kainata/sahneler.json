    },
    {
      "number": 24,
      "speaker": "Anlatıcı",
      "text": "İnsanı, doğayı ve kâinatı incelemek; bilgi edinmek, hayret etmek ve şükretmek için",
      "chapter": "Merak ve saygı",
      "paragraph": 11,
      "imageFile": "gorseller/24-gorsel.jpg",
      "image": "gorseller/24-gorsel.jpg",
      "audioFile": "sesler/24-anlatici.mp3",
      "speechTextFile": "24-seslendirme.txt",
