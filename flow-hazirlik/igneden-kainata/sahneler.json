    },
    {
      "number": 8,
      "speaker": "Anlatıcı",
      "text": "Bir treni düşün. Vagonlar birbirine bağlanır; lokomotif onları",
      "chapter": "Nedenler üzerine düşünmek",
      "paragraph": 5,
      "imageFile": "gorseller/08-gorsel.jpg",
      "image": "gorseller/08-gorsel.jpg",
      "audioFile": "sesler/08-anlatici.mp3",
