    },
    {
      "number": 13,
      "speaker": "Anlatıcı",
      "text": "Peki, Allah’ı kim yarattı? İslam inancında Allah ezelîdir;",
      "chapter": "Yaratılmamış yaratıcı",
      "paragraph": 8,
      "imageFile": "gorseller/13-gorsel.jpg",
      "image": "gorseller/13-gorsel.jpg",
