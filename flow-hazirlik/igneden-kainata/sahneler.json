      "audioDurationSeconds": 7.627755,
      "maxSeconds": 8,
      "flowPromptFile": "02-flow.txt"
    },
    {
      "number": 3,
      "speaker": "Anlatıcı",
      "text": "Bir iğnenin üretilmesi; malzeme bilgisi, tasarım, araçlar ve insan emeği gerektirir.",
