      "paragraph": 2,
      "imageFile": "gorseller/03-gorsel.jpg",
      "image": "gorseller/03-gorsel.jpg",
      "audioFile": "sesler/03-anlatici.mp3",
      "speechTextFile": "03-seslendirme.txt",
      "startFrame": 448,
      "endFrame": 641,
      "startSeconds": 14.933333333333334,
      "endSeconds": 21.366666666666667,
      "durationSeconds": 6.433333333333334,
      "imageSha256": "cc2ad0c714fe0c7e4b79b41207f8e53dcca46fe9e9326f154f752a9e7175c099",
      "audioDurationSeconds": 6.478367,
      "maxSeconds": 8,
      "flowPromptFile": "03-flow.txt"
    },
    {
      "number": 4,
      "speaker": "Anlatıcı",
      "text": "Masalar, binalar, otomobiller, trenler ve robotlarda da benzer bir hazırlık ve üretim süreci görürüz.",
      "chapter": "Emek ve üretim",
      "paragraph": 2,
      "imageFile": "gorseller/04-gorsel.jpg",
      "image": "gorseller/04-gorsel.jpg",
      "audioFile": "sesler/04-anlatici.mp3",
      "speechTextFile": "04-seslendirme.txt",
      "startFrame": 641,
      "endFrame": 856,
      "startSeconds": 21.366666666666667,
      "endSeconds": 28.533333333333335,
      "durationSeconds": 7.166666666666667,
      "imageSha256": "aa0f87c0c7a8e40552440105131960235b3218d8ead61d80669eb6c76a940b91",
      "audioDurationSeconds": 7.209796,
      "maxSeconds": 8,
      "flowPromptFile": "04-flow.txt"
    },
    {
      "number": 5,
      "speaker": "Anlatıcı",
      "text": "Kaynak metin, insanın ve kâinatın karmaşık yapısından hareketle yaratılış üzerinde düşünmeye davet eder.",
      "chapter": "Yaratılış üzerine düşünmek",
      "paragraph": 3,
      "imageFile": "gorseller/05-gorsel.jpg",
      "image": "gorseller/05-gorsel.jpg",
      "audioFile": "sesler/05-anlatici.mp3",
      "speechTextFile": "05-seslendirme.txt",
      "startFrame": 856,
      "endFrame": 1069,
      "startSeconds": 28.533333333333335,
      "endSeconds": 35.63333333333333,
      "durationSeconds": 7.1,
      "imageSha256": "cda1942e61c483abf7669c9d519600537039e7c2f98ba9d63761873ec53f7e39",
      "audioDurationSeconds": 7.131429,
      "maxSeconds": 8,
      "flowPromptFile": "05-flow.txt"
    },
    {
      "number": 6,
      "speaker": "Anlatıcı",
      "text": "İslam inancında bütün varlıkların yaratıcısı Allah’tır. Bu, metnin temel inanç yaklaşımıdır.",
      "chapter": "Yaratılış üzerine düşünmek",
      "paragraph": 3,
      "imageFile": "gorseller/06-gorsel.jpg",
      "image": "gorseller/06-gorsel.jpg",
      "audioFile": "sesler/06-anlatici.mp3",
      "speechTextFile": "06-seslendirme.txt",
      "startFrame": 1069,
      "endFrame": 1284,
      "startSeconds": 35.63333333333333,
      "endSeconds": 42.8,
      "durationSeconds": 7.166666666666667,
      "imageSha256": "92301788e2c7eb37b7dba259c51cc327d46753fdc2cf01a55d8b8bcf854b2afa",
      "audioDurationSeconds": 7.209796,
      "maxSeconds": 8,
      "flowPromptFile": "06-flow.txt"
    },
    {
      "number": 7,
      "speaker": "Anlatıcı",
      "text": "İğne ile evren arasında kurulan bağlantı bir benzetmedir. Bir benzetme, düşünmeyi",
      "chapter": "Benzetmenin sınırları",
      "paragraph": 4,
      "imageFile": "gorseller/07-gorsel.jpg",
      "image": "gorseller/07-gorsel.jpg",
      "audioFile": "sesler/07-anlatici.mp3",
      "speechTextFile": "07-seslendirme.txt",
      "startFrame": 1284,
      "endFrame": 1449,
      "startSeconds": 42.8,
      "endSeconds": 48.3,
      "durationSeconds": 5.5,
      "imageSha256": "b8367982bc0c38d827020ca319e4fa7b1108834a4374956d2936c34b2f5b55ff",
      "audioDurationSeconds": 5.537959,
      "maxSeconds": 8,
      "flowPromptFile": "07-flow.txt"
    },
    {
      "number": 8,
      "speaker": "Anlatıcı",
      "text": "kolaylaştırabilir; fakat tek başına bütün bilimsel süreçleri açıklamaz. Farklı",
      "chapter": "Benzetmenin sınırları",
      "paragraph": 4,
      "imageFile": "gorseller/08-gorsel.jpg",
      "image": "gorseller/08-gorsel.jpg",
      "audioFile": "sesler/08-anlatici.mp3",
