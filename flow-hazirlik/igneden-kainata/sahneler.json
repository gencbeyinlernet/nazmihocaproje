      "audioDurationSeconds": 5.537959,
      "maxSeconds": 8,
      "flowPromptFile": "08-flow.txt"
    },
    {
      "number": 9,
      "speaker": "Anlatıcı",
      "text": "görüşleri değerlendirirken gerekçeleri incelemek ve insanlara saygılı davranmak gerekir.",
      "chapter": "Benzetmenin sınırları",
      "paragraph": 4,
      "imageFile": "gorseller/09-gorsel.jpg",
      "image": "gorseller/09-gorsel.jpg",
      "audioFile": "sesler/09-anlatici.mp3",
      "speechTextFile": "09-seslendirme.txt",
      "startFrame": 1614,
