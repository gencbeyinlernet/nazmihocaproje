      "maxSeconds": 8,
      "flowPromptFile": "14-flow.txt"
    },
    {
      "number": 15,
      "speaker": "Anlatıcı",
      "text": "Merak etmekten vazgeçme. Sorularını açıkça sor. Gerekçeleri",
      "chapter": "Merakını koru",
      "paragraph": 9,
      "imageFile": "gorseller/15-gorsel.jpg",
      "image": "gorseller/15-gorsel.jpg",
