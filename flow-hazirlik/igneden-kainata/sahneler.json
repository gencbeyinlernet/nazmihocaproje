      "audioDurationSeconds": 7.836735,
      "maxSeconds": 8,
      "flowPromptFile": "10-flow.txt"
    },
    {
      "number": 11,
      "speaker": "Anlatıcı",
      "text": "Bir nar ağacına bak. Toprak, su, hava ve Güneş... Bilim, ağacın nasıl",
      "chapter": "Bir nar ağacına bak",
      "paragraph": 7,
      "imageFile": "gorseller/11-gorsel.jpg",
      "image": "gorseller/11-gorsel.jpg",
