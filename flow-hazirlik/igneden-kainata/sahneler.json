      "maxSeconds": 8,
      "flowPromptFile": "08-flow.txt"
    },
    {
      "number": 9,
      "speaker": "Anlatıcı",
      "text": "çeker. Bu örnek, nedenler zincirinin başlangıcını düşünmemize yardım eder.",
      "chapter": "Nedenler üzerine düşünmek",
      "paragraph": 5,
      "imageFile": "gorseller/09-gorsel.jpg",
      "image": "gorseller/09-gorsel.jpg",
