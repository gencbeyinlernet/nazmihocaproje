    {
      "number": 12,
      "speaker": "Anlatıcı",
      "text": "büyüdüğünü araştırır. İnanan insan da bu hayatta Allah’ın ilmini ve kudretini görür.",
      "chapter": "Bir nar ağacına bak",
      "paragraph": 7,
      "imageFile": "gorseller/12-gorsel.jpg",
      "image": "gorseller/12-gorsel.jpg",
