      "audioDurationSeconds": 5.537959,
      "maxSeconds": 8,
      "flowPromptFile": "22-flow.txt"
    },
    {
      "number": 23,
      "speaker": "Anlatıcı",
      "text": "alınmaz. Kaynak metnin nedenler zinciriyle anlatmak istediği temel düşünce budur.",
      "chapter": "Yaratılmamış yaratıcı",
      "paragraph": 10,
      "imageFile": "gorseller/23-gorsel.jpg",
      "image": "gorseller/23-gorsel.jpg",
      "audioFile": "sesler/23-anlatici.mp3",
