  "mediaBase": "https://raw.githubusercontent.com/gencbeyinlernet/nazmihocaproje/82ff5b616244f51980167b3ab042b03598de43d8/anlatici-v2/gunes-scuti/",
  "scenes": [
    {
      "number": 1,
      "speaker": "Anlatıcı",
      "text": "Güneş hiç doğmasaydı, Dünya karanlık ve donmuş bir kayaya dönerdi.",
      "chapter": "Güneş ve yaşam",
      "sourceScene": 7,
      "imageFile": "gorseller/01-gorsel.jpg",
      "image": "gorseller/01-gorsel.jpg",
      "audioFile": "sesler/01-anlatici.mp3",
      "speechTextFile": "01-seslendirme.txt",
      "startFrame": 0,
      "endFrame": 147,
      "startSeconds": 0.0,
      "endSeconds": 4.9,
      "durationSeconds": 4.9,
      "imageSha256": "e315610da7ff228b78772a9748c23b403003dafb35175258f70702fdcc8fea3e",
      "audioDurationSeconds": 4.937143,
      "maxSeconds": 8
    },
    {
      "number": 2,
      "speaker": "Anlatıcı",
      "text": "Güneş ışığıyla bitkiler besin üretir; su döngüsü de bu enerjiyle işler.",
      "chapter": "Güneş ve yaşam",
      "sourceScene": 8,
      "imageFile": "gorseller/02-gorsel.jpg",
      "image": "gorseller/02-gorsel.jpg",
      "audioFile": "sesler/02-anlatici.mp3",
      "speechTextFile": "02-seslendirme.txt",
      "startFrame": 147,
      "endFrame": 301,
      "startSeconds": 4.9,
      "endSeconds": 10.033333333333333,
      "durationSeconds": 5.133333333333333,
      "imageSha256": "422391211f9c1229fcd8f740a130af786cd5936f9b54c5ae8c8fd7f29f665f75",
      "audioDurationSeconds": 5.172245,
      "maxSeconds": 8
    },
    {
      "number": 3,
      "speaker": "Anlatıcı",
      "text": "Yani Güneş, Dünya'daki yaşamın temel enerji kaynaklarından biridir.",
      "chapter": "Güneş ve yaşam",
      "sourceScene": 9,
      "imageFile": "gorseller/03-gorsel.jpg",
      "image": "gorseller/03-gorsel.jpg",
      "audioFile": "sesler/03-anlatici.mp3",
      "speechTextFile": "03-seslendirme.txt",
      "startFrame": 301,
      "endFrame": 442,
      "startSeconds": 10.033333333333333,
      "endSeconds": 14.733333333333333,
      "durationSeconds": 4.699999999999999,
      "imageSha256": "b6f2d4d25df202391577e480e9708e2f17a277406fdf6b2865cae817c6573cf2",
      "audioDurationSeconds": 4.728163,
      "maxSeconds": 8
    },
    {
      "number": 4,
      "speaker": "Anlatıcı",
      "text": "Güneş'in hacmine, yaklaşık bir milyon üç yüz bin Dünya sığar.",
      "chapter": "Güneş'in büyüklüğü",
      "sourceScene": 11,
      "imageFile": "gorseller/04-gorsel.jpg",
      "image": "gorseller/04-gorsel.jpg",
      "audioFile": "sesler/04-anlatici.mp3",
      "speechTextFile": "04-seslendirme.txt",
      "startFrame": 442,
      "endFrame": 577,
      "startSeconds": 14.733333333333333,
      "endSeconds": 19.233333333333334,
      "durationSeconds": 4.500000000000002,
      "imageSha256": "bff517b5fcc9f7188bcd54ed292f74bc2c8bb33eda3e9d1893880f9c879a8c09",
      "audioDurationSeconds": 4.545306,
      "maxSeconds": 8
    },
    {
      "number": 5,
      "speaker": "Anlatıcı",
      "text": "Görünür yüzeyinin sıcaklığı yaklaşık beş bin beş yüz derecedir.",
      "chapter": "Güneş'in büyüklüğü",
      "sourceScene": 12,
      "imageFile": "gorseller/05-gorsel.jpg",
      "image": "gorseller/05-gorsel.jpg",
      "audioFile": "sesler/05-anlatici.mp3",
      "speechTextFile": "05-seslendirme.txt",
      "startFrame": 577,
      "endFrame": 707,
      "startSeconds": 19.233333333333334,
      "endSeconds": 23.566666666666666,
      "durationSeconds": 4.333333333333332,
      "imageSha256": "4bb7e294de8804d2933a2f431e7bd4cfb94f4864ef80973d4d2e7af40801dab8",
      "audioDurationSeconds": 4.362449,
      "maxSeconds": 8
    },
    {
      "number": 6,
      "speaker": "Anlatıcı",
      "text": "Çekirdekte sıcaklık on beş milyon dereceyi bulur. Yoğunluk, suyun yüz elli katıdır.",
      "chapter": "Güneş'in büyüklüğü",
      "sourceScene": 13,
      "imageFile": "gorseller/06-gorsel.jpg",
      "image": "gorseller/06-gorsel.jpg",
      "audioFile": "sesler/06-anlatici.mp3",
      "speechTextFile": "06-seslendirme.txt",
      "startFrame": 707,
      "endFrame": 877,
      "startSeconds": 23.566666666666666,
      "endSeconds": 29.233333333333334,
      "durationSeconds": 5.666666666666668,
      "imageSha256": "6dd210e39aaf7f1dbca76d7e8c80b680e2d99e01f88abbaf429a00801ab33132",
      "audioDurationSeconds": 5.694694,
      "maxSeconds": 8
    },
    {
      "number": 7,
      "speaker": "Anlatıcı",
      "text": "Bu sıcaklık ve basınçta hidrojen çekirdekleri birleşir. Buna füzyon denir.",
      "chapter": "Çekirdekteki enerji",
      "sourceScene": 17,
      "imageFile": "gorseller/07-gorsel.jpg",
      "image": "gorseller/07-gorsel.jpg",
      "audioFile": "sesler/07-anlatici.mp3",
      "speechTextFile": "07-seslendirme.txt",
      "startFrame": 877,
      "endFrame": 1040,
      "startSeconds": 29.233333333333334,
      "endSeconds": 34.666666666666664,
      "durationSeconds": 5.43333333333333,
      "imageSha256": "6f7dfa5fc8907bce8de6452ab24f861c00828ae83b0472e7548b989bd08007b7",
      "audioDurationSeconds": 5.485714,
      "maxSeconds": 8
    },
    {
      "number": 8,
      "speaker": "Anlatıcı",
      "text": "Her saniye yaklaşık altı yüz milyon ton hidrojen, helyuma dönüşür.",
      "chapter": "Çekirdekteki enerji",
      "sourceScene": 20,
      "imageFile": "gorseller/08-gorsel.jpg",
      "image": "gorseller/08-gorsel.jpg",
      "audioFile": "sesler/08-anlatici.mp3",
      "speechTextFile": "08-seslendirme.txt",
      "startFrame": 1040,
      "endFrame": 1182,
      "startSeconds": 34.666666666666664,
      "endSeconds": 39.4,
      "durationSeconds": 4.733333333333334,
      "imageSha256": "60e0290f95aaebdbfe0427e3c17853241d391b23c015566c5588ade8284e3f61",
      "audioDurationSeconds": 4.780408,
      "maxSeconds": 8
    },
    {
      "number": 9,
      "speaker": "Anlatıcı",
      "text": "Aradaki yaklaşık dört milyon tonluk kütle farkı, enerji olarak açığa çıkar.",
      "chapter": "Çekirdekteki enerji",
      "sourceScene": 24,
      "imageFile": "gorseller/09-gorsel.jpg",
      "image": "gorseller/09-gorsel.jpg",
      "audioFile": "sesler/09-anlatici.mp3",
      "speechTextFile": "09-seslendirme.txt",
      "startFrame": 1182,
      "endFrame": 1340,
      "startSeconds": 39.4,
      "endSeconds": 44.666666666666664,
      "durationSeconds": 5.266666666666666,
      "imageSha256": "f204a27452c1f883ce181e3f825ef9b1bb2939232d0b8199d521ab8782525a0a",
      "audioDurationSeconds": 5.302857,
      "maxSeconds": 8
    },
    {
      "number": 10,
      "speaker": "Anlatıcı",
      "text": "Hiroşima bombası ölçü alınırsa, bu enerji saniyede yaklaşık altı trilyon bombaya denktir.",
      "chapter": "Enerjiyi karşılaştırmak",
      "sourceScene": 49,
      "imageFile": "gorseller/10-gorsel.jpg",
      "image": "gorseller/10-gorsel.jpg",
      "audioFile": "sesler/10-anlatici.mp3",
      "speechTextFile": "10-seslendirme.txt",
      "startFrame": 1340,
      "endFrame": 1532,
      "startSeconds": 44.666666666666664,
      "endSeconds": 51.06666666666667,
      "durationSeconds": 6.400000000000006,
      "imageSha256": "b4542bb8a8b9448ac6e2a9ceff8105bfd94417f5ebea9578be9bff40bc474942",
      "audioDurationSeconds": 6.426122,
      "maxSeconds": 8
    },
    {
      "number": 11,
      "speaker": "Anlatıcı",
      "text": "Bu enerji her yöne yayılır. Yok olmaz; ışınım olarak yoluna devam eder.",
      "chapter": "Dünya'ya ulaşan ışık",
      "sourceScene": 28,
      "imageFile": "gorseller/11-gorsel.jpg",
      "image": "gorseller/11-gorsel.jpg",
      "audioFile": "sesler/11-anlatici.mp3",
      "speechTextFile": "11-seslendirme.txt",
      "startFrame": 1532,
      "endFrame": 1693,
      "startSeconds": 51.06666666666667,
      "endSeconds": 56.43333333333333,
      "durationSeconds": 5.36666666666666,
      "imageSha256": "a1457014637c89211eb7ac9049f450423a05315db36c6c8324e7bb957e8d67d3",
      "audioDurationSeconds": 5.407347,
      "maxSeconds": 8
    },
    {
      "number": 12,
      "speaker": "Anlatıcı",
      "text": "Dünya'ya ise bu enerjinin yalnızca iki virgül iki milyarda biri ulaşır.",
      "chapter": "Dünya'ya ulaşan ışık",
      "sourceScene": 27,
      "imageFile": "gorseller/12-gorsel.jpg",
      "image": "gorseller/12-gorsel.jpg",
      "audioFile": "sesler/12-anlatici.mp3",
      "speechTextFile": "12-seslendirme.txt",
      "startFrame": 1693,
      "endFrame": 1846,
      "startSeconds": 56.43333333333333,
      "endSeconds": 61.53333333333333,
      "durationSeconds": 5.100000000000001,
      "imageSha256": "efbf11c1536b72cef82a108a2f3408474abf2008a0b0f37cc8edbccb9ea5972a",
      "audioDurationSeconds": 5.146122,
      "maxSeconds": 8
    },
    {
      "number": 13,
      "speaker": "Anlatıcı",
      "text": "Bin dokuz yüz altmış birde, Novaya Zemlya'da Çar Bombası denendi.",
      "chapter": "Tarihsel karşılaştırma",
      "sourceScene": 30,
      "imageFile": "gorseller/13-gorsel.jpg",
      "image": "gorseller/13-gorsel.jpg",
      "audioFile": "sesler/13-anlatici.mp3",
      "speechTextFile": "13-seslendirme.txt",
      "startFrame": 1846,
      "endFrame": 1974,
      "startSeconds": 61.53333333333333,
      "endSeconds": 65.8,
      "durationSeconds": 4.266666666666666,
      "imageSha256": "455a04ab9aa09a560b49840d8dfe81de8620831e8fabcc239bf0994774a7d38f",
      "audioDurationSeconds": 4.310204,
      "maxSeconds": 8
    },
    {
      "number": 14,
      "speaker": "Anlatıcı",
      "text": "Tarih otuz Ekim'di; saat, evrensel saatle yaklaşık sekiz buçuktu.",
      "chapter": "Tarihsel karşılaştırma",
      "sourceScene": 31,
      "imageFile": "gorseller/14-gorsel.jpg",
      "image": "gorseller/14-gorsel.jpg",
      "audioFile": "sesler/14-anlatici.mp3",
      "speechTextFile": "14-seslendirme.txt",
      "startFrame": 1974,
      "endFrame": 2137,
      "startSeconds": 65.8,
      "endSeconds": 71.23333333333333,
      "durationSeconds": 5.433333333333337,
      "imageSha256": "73b4836f1bffbb910fbcf95a5ac5fed4f3fba7ecedb0a74833eb37b434406acd",
      "audioDurationSeconds": 5.459592,
      "maxSeconds": 8
    },
    {
      "number": 15,
      "speaker": "Anlatıcı",
      "text": "Gücü genellikle elli megaton diye anılır; eski tahminlerde elli yedi geçer.",
      "chapter": "Tarihsel karşılaştırma",
      "sourceScene": 34,
      "imageFile": "gorseller/15-gorsel.jpg",
      "image": "gorseller/15-gorsel.jpg",
      "audioFile": "sesler/15-anlatici.mp3",
      "speechTextFile": "15-seslendirme.txt",
      "startFrame": 2137,
      "endFrame": 2294,
      "startSeconds": 71.23333333333333,
      "endSeconds": 76.46666666666667,
      "durationSeconds": 5.233333333333334,
      "imageSha256": "5c9acadc4cb7ab9ae1fa4f97d51f62124e7a5ed01cba2c5b74fe3f06eb133d72",
      "audioDurationSeconds": 5.276735,
      "maxSeconds": 8
    },
    {
      "number": 16,
      "speaker": "Anlatıcı",
      "text": "Patlama, yaklaşık dokuz yüz altmış beş kilometre öteden görülmüştü.",
      "chapter": "Tarihsel karşılaştırma",
      "sourceScene": 36,
      "imageFile": "gorseller/16-gorsel.jpg",
      "image": "gorseller/16-gorsel.jpg",
      "audioFile": "sesler/16-anlatici.mp3",
      "speechTextFile": "16-seslendirme.txt",
      "startFrame": 2294,
      "endFrame": 2422,
      "startSeconds": 76.46666666666667,
      "endSeconds": 80.73333333333333,
      "durationSeconds": 4.266666666666666,
      "imageSha256": "f3872b90765de0b73d8542090a21115726fb1c855ade48d156ee96f054d2e1f1",
      "audioDurationSeconds": 4.310204,
      "maxSeconds": 8
    },
    {
      "number": 17,
      "speaker": "Anlatıcı",
      "text": "Güneş, bize yaklaşık yüz elli milyon kilometre uzaklıktadır.",
      "chapter": "Bir uzaklık düşünelim",
      "sourceScene": 38,
      "imageFile": "gorseller/17-gorsel.jpg",
      "image": "gorseller/17-gorsel.jpg",
      "audioFile": "sesler/17-anlatici.mp3",
      "speechTextFile": "17-seslendirme.txt",
      "startFrame": 2422,
      "endFrame": 2539,
      "startSeconds": 80.73333333333333,
      "endSeconds": 84.63333333333334,
      "durationSeconds": 3.9000000000000057,
      "imageSha256": "1a1b760f36173c1a1ad86c13913e24fe3eca60ea4eed565866ab14e9214f8ca5",
      "audioDurationSeconds": 3.94449,
      "maxSeconds": 8
    },
    {
      "number": 18,
      "speaker": "Anlatıcı",
      "text": "Saatte iki yüz kilometreyle durmadan gitsek, bu yol yaklaşık seksen altı yıl sürerdi.",
      "chapter": "Bir uzaklık düşünelim",
      "sourceScene": 41,
      "imageFile": "gorseller/18-gorsel.jpg",
      "image": "gorseller/18-gorsel.jpg",
      "audioFile": "sesler/18-anlatici.mp3",
      "speechTextFile": "18-seslendirme.txt",
      "startFrame": 2539,
      "endFrame": 2710,
      "startSeconds": 84.63333333333334,
      "endSeconds": 90.33333333333333,
      "durationSeconds": 5.699999999999989,
      "imageSha256": "12e43df7197c9702d99035725c58b3823dbd201f238dade6dfb6414ac0351057",
      "audioDurationSeconds": 5.746939,
      "maxSeconds": 8
    },
    {
      "number": 19,
      "speaker": "Anlatıcı",
      "text": "Güneş ışığı ise aynı yolu yaklaşık sekiz dakika yirmi saniyede alır.",
      "chapter": "Bir uzaklık düşünelim",
      "sourceScene": 44,
      "imageFile": "gorseller/19-gorsel.jpg",
      "image": "gorseller/19-gorsel.jpg",
      "audioFile": "sesler/19-anlatici.mp3",
      "speechTextFile": "19-seslendirme.txt",
      "startFrame": 2710,
      "endFrame": 2856,
      "startSeconds": 90.33333333333333,
      "endSeconds": 95.2,
      "durationSeconds": 4.866666666666674,
      "imageSha256": "573478b231e4ad5a3c24e4497b5bcefa4afe514632997a59f680093ca56335f8",
      "audioDurationSeconds": 4.91102,
      "maxSeconds": 8
    },
    {
      "number": 20,
      "speaker": "Anlatıcı",
      "text": "Bir sobaya yaklaştıkça ısınırız; çok yaklaşırsak yanarız.",
      "chapter": "Soba benzetmesi",
      "sourceScene": 43,
      "imageFile": "gorseller/20-gorsel.jpg",
      "image": "gorseller/20-gorsel.jpg",
      "audioFile": "sesler/20-anlatici.mp3",
      "speechTextFile": "20-seslendirme.txt",
      "startFrame": 2856,
      "endFrame": 2984,
      "startSeconds": 95.2,
      "endSeconds": 99.46666666666667,
      "durationSeconds": 4.266666666666666,
      "imageSha256": "53b56fc55dc360f0c10e6587028002899338e0f5fae6eb9dd053325dedb6dec7",
      "audioDurationSeconds": 4.310204,
      "maxSeconds": 8
    },
    {
      "number": 21,
      "speaker": "Anlatıcı",
      "text": "Güneş ise bizi uzaktan ısıtır, aydınlatır; bitkiler onun ışığıyla meyve verir.",
      "chapter": "Soba benzetmesi",
      "sourceScene": 46,
      "imageFile": "gorseller/21-gorsel.jpg",
      "image": "gorseller/21-gorsel.jpg",
      "audioFile": "sesler/21-anlatici.mp3",
      "speechTextFile": "21-seslendirme.txt",
      "startFrame": 2984,
      "endFrame": 3164,
      "startSeconds": 99.46666666666667,
      "endSeconds": 105.46666666666667,
      "durationSeconds": 6.0,
      "imageSha256": "9c8391a3e56beb29427a13cb0d7f86b756540068eb5d9a3b68c4ccdb3970a949",
      "audioDurationSeconds": 6.034286,
      "maxSeconds": 8
    },
    {
      "number": 22,
      "speaker": "Anlatıcı",
      "text": "İnsanlar bombaları biriken bilgiyle yaptı. Güneş'te ise bomba yok, doğal füzyon var.",
      "chapter": "Benzetmenin sınırı",
      "sourceScene": 50,
      "imageFile": "gorseller/22-gorsel.jpg",
      "image": "gorseller/22-gorsel.jpg",
      "audioFile": "sesler/22-anlatici.mp3",
      "speechTextFile": "22-seslendirme.txt",
      "startFrame": 3164,
      "endFrame": 3353,
      "startSeconds": 105.46666666666667,
      "endSeconds": 111.76666666666667,
      "durationSeconds": 6.299999999999997,
      "imageSha256": "92a58d82f881baf2942f8cec06b5e92ee00362f8025986225e693a9eedf7db7d",
      "audioDurationSeconds": 6.347755,
      "maxSeconds": 8
    },
    {
      "number": 23,
      "speaker": "Anlatıcı",
      "text": "Bir tüp patlayınca yanındakiler de patlayabilir. Peki Güneş neden patlamıyor?",
      "chapter": "Güneş neden dengede",
      "sourceScene": 56,
      "imageFile": "gorseller/23-gorsel.jpg",
      "image": "gorseller/23-gorsel.jpg",
      "audioFile": "sesler/23-anlatici.mp3",
      "speechTextFile": "23-seslendirme.txt",
      "startFrame": 3353,
      "endFrame": 3522,
      "startSeconds": 111.76666666666667,
      "endSeconds": 117.4,
      "durationSeconds": 5.63333333333334,
      "imageSha256": "5e2e87beae21c48d33b8b749fd8f093e67abc1a0399bb17d71f0c8108bc008a2",
      "audioDurationSeconds": 5.668571,
      "maxSeconds": 8
    },
    {
      "number": 24,
      "speaker": "Anlatıcı",
      "text": "Çünkü içe çeken kütleçekimi, dışa iten basınçla dengededir.",
      "chapter": "Güneş neden dengede",
      "sourceScene": 58,
      "imageFile": "gorseller/24-gorsel.jpg",
      "image": "gorseller/24-gorsel.jpg",
      "audioFile": "sesler/24-anlatici.mp3",
      "speechTextFile": "24-seslendirme.txt",
      "startFrame": 3522,
      "endFrame": 3651,
      "startSeconds": 117.4,
      "endSeconds": 121.7,
      "durationSeconds": 4.299999999999997,
      "imageSha256": "dd63701f687bcbd05ce7b36761f8796bd0191fe15e8fa62557b48b0cc072b83b",
      "audioDurationSeconds": 4.336327,
      "maxSeconds": 8
    },
    {
      "number": 25,
      "speaker": "Anlatıcı",
      "text": "İnanan insan, bu dengede ve yaşamı taşıyan ışıkta Allah'ın yaratışını görür, şükreder.",
      "chapter": "Yaratılış üzerine düşünme",
      "sourceScene": 54,
      "imageFile": "gorseller/25-gorsel.jpg",
      "image": "gorseller/25-gorsel.jpg",
      "audioFile": "sesler/25-anlatici.mp3",
      "speechTextFile": "25-seslendirme.txt",
      "startFrame": 3651,
      "endFrame": 3844,
      "startSeconds": 121.7,
