  "scenes": [
    {
      "number": 1,
      "speaker": "Anlatıcı",
      "text": "Cansız elementler, tesadüfen bir araya gelip bir aspirin yapabilir mi?",
      "chapter": "Bir soru",
      "sourceScene": null,
      "sourceImage": "01.png",
      "imageFile": "gorseller/01-gorsel.jpg",
      "image": "gorseller/01-gorsel.jpg",
      "audioFile": "sesler/01-anlatici.mp3",
      "speechTextFile": "01-seslendirme.txt",
      "startFrame": 0,
      "endFrame": 147,
      "startSeconds": 0.0,
      "endSeconds": 4.9,
      "durationSeconds": 4.9,
      "imageSha256": "e609a862a5bcffc1de3b241fee05fde181142cb78878ff8320d6d438bd9314b9",
      "audioDurationSeconds": 4.937143,
      "maxSeconds": 8
    },
    {
      "number": 2,
      "speaker": "Anlatıcı",
      "text": "Bir öğretmen, öğrencilerine ilginç bir hikâye anlatır.",
      "chapter": "Düşünce deneyi",
      "sourceScene": null,
      "sourceImage": "02.png",
      "imageFile": "gorseller/02-gorsel.jpg",
      "image": "gorseller/02-gorsel.jpg",
      "audioFile": "sesler/02-anlatici.mp3",
      "speechTextFile": "02-seslendirme.txt",
      "startFrame": 147,
      "endFrame": 260,
      "startSeconds": 4.9,
      "endSeconds": 8.666666666666666,
      "durationSeconds": 3.7666666666666657,
      "imageSha256": "b58b0c92d4a3bd54013014c0401efaab9f35300093ad89fe1db8c2cf61ea2c99",
      "audioDurationSeconds": 3.813878,
      "maxSeconds": 8
    },
    {
      "number": 3,
      "speaker": "Anlatıcı",
      "text": "Bir gün şiddetli bir rüzgârla laboratuvarın penceresi ardına kadar açılır.",
      "chapter": "Düşünce deneyi",
      "sourceScene": null,
      "sourceImage": "03.png",
      "imageFile": "gorseller/03-gorsel.jpg",
      "image": "gorseller/03-gorsel.jpg",
      "audioFile": "sesler/03-anlatici.mp3",
      "speechTextFile": "03-seslendirme.txt",
      "startFrame": 260,
      "endFrame": 407,
      "startSeconds": 8.666666666666666,
      "endSeconds": 13.566666666666666,
      "durationSeconds": 4.9,
      "imageSha256": "1c11c51929038e67e9534040133f4fe78a72821b043dfe2e79f1771b97453a63",
      "audioDurationSeconds": 4.937143,
      "maxSeconds": 8
    },
    {
      "number": 4,
      "speaker": "Anlatıcı",
      "text": "Raflardaki kavanozlar devrilir, içindeki maddeler masaya dökülür.",
      "chapter": "Düşünce deneyi",
      "sourceScene": null,
      "sourceImage": "04.png",
      "imageFile": "gorseller/04-gorsel.jpg",
      "image": "gorseller/04-gorsel.jpg",
      "audioFile": "sesler/04-anlatici.mp3",
      "speechTextFile": "04-seslendirme.txt",
      "startFrame": 407,
      "endFrame": 539,
      "startSeconds": 13.566666666666666,
      "endSeconds": 17.966666666666665,
      "durationSeconds": 4.399999999999999,
      "imageSha256": "5bc6341b73db5c41d287e97dc49a5910ba79672b857dba728e167a8a584769cc",
      "audioDurationSeconds": 4.440816,
      "maxSeconds": 8
    },
    {
      "number": 5,
      "speaker": "Anlatıcı",
      "text": "Ve dökülen maddeler, kendiliğinden aspirine dönüşür. Öyle mi?",
      "chapter": "Düşünce deneyi",
      "sourceScene": null,
      "sourceImage": "05.png",
      "imageFile": "gorseller/05-gorsel.jpg",
      "image": "gorseller/05-gorsel.jpg",
      "audioFile": "sesler/05-anlatici.mp3",
      "speechTextFile": "05-seslendirme.txt",
      "startFrame": 539,
      "endFrame": 671,
      "startSeconds": 17.966666666666665,
      "endSeconds": 22.366666666666667,
      "durationSeconds": 4.400000000000002,
      "imageSha256": "d6ec0fe24a2bde585156df163fe01c3a8c9cf4db9735a5de2d063c7b60fd8204",
      "audioDurationSeconds": 4.440816,
      "maxSeconds": 8
    },
    {
      "number": 6,
      "speaker": "Anlatıcı",
      "text": "Öğrenciler gülerek itiraz eder: Hocam, böyle bir şey olur mu?",
      "chapter": "Öğrencilerin itirazı",
      "sourceScene": null,
      "sourceImage": "06.png",
      "imageFile": "gorseller/06-gorsel.jpg",
      "image": "gorseller/06-gorsel.jpg",
      "audioFile": "sesler/06-anlatici.mp3",
      "speechTextFile": "06-seslendirme.txt",
      "startFrame": 671,
      "endFrame": 797,
      "startSeconds": 22.366666666666667,
      "endSeconds": 26.566666666666666,
      "durationSeconds": 4.199999999999999,
      "imageSha256": "91e6137a5d66ae84d0d2e0eff2168e72ead989a2d0d60cf4dc78aacb3788da88",
      "audioDurationSeconds": 4.231837,
      "maxSeconds": 8
    },
    {
      "number": 7,
      "speaker": "Anlatıcı",
      "text": "Haklıdırlar. İlaçlar, bilim insanlarının yıllar süren çalışmalarıyla geliştirilir.",
      "chapter": "İlaç nasıl yapılır?",
      "sourceScene": null,
      "sourceImage": "07.png",
      "imageFile": "gorseller/07-gorsel.jpg",
      "image": "gorseller/07-gorsel.jpg",
      "audioFile": "sesler/07-anlatici.mp3",
      "speechTextFile": "07-seslendirme.txt",
      "startFrame": 797,
      "endFrame": 964,
      "startSeconds": 26.566666666666666,
      "endSeconds": 32.13333333333333,
      "durationSeconds": 5.566666666666666,
      "imageSha256": "dbd1e269e3debe265eafdec874de33d27a5c39810a39eb2d2bdf2b34306f1241",
      "audioDurationSeconds": 5.616327,
      "maxSeconds": 8
    },
    {
      "number": 8,
      "speaker": "Anlatıcı",
      "text": "Gözlem yapılır, deneyler tekrarlanır, sonuçlar dikkatle incelenir.",
      "chapter": "İlaç nasıl yapılır?",
      "sourceScene": null,
      "sourceImage": "08.png",
      "imageFile": "gorseller/08-gorsel.jpg",
      "image": "gorseller/08-gorsel.jpg",
      "audioFile": "sesler/08-anlatici.mp3",
      "speechTextFile": "08-seslendirme.txt",
      "startFrame": 964,
      "endFrame": 1109,
      "startSeconds": 32.13333333333333,
      "endSeconds": 36.96666666666667,
      "durationSeconds": 4.833333333333336,
      "imageSha256": "937e8f7619557415c9aa29544d4bd960605ec7cd4a91303808f4da75e5a43c9c",
      "audioDurationSeconds": 4.884898,
      "maxSeconds": 8
    },
    {
      "number": 9,
      "speaker": "Anlatıcı",
      "text": "Aspirinin hikâyesi, söğüt kabuğuyla başlayan uzun bir araştırmaya dayanır.",
      "chapter": "Aspirinin hikâyesi",
      "sourceScene": null,
      "sourceImage": "09.png",
      "imageFile": "gorseller/09-gorsel.jpg",
      "image": "gorseller/09-gorsel.jpg",
      "audioFile": "sesler/09-anlatici.mp3",
      "speechTextFile": "09-seslendirme.txt",
      "startFrame": 1109,
      "endFrame": 1259,
      "startSeconds": 36.96666666666667,
      "endSeconds": 41.96666666666667,
      "durationSeconds": 5.0,
      "imageSha256": "04e7e770136ce07a2576d7df723cd945604ec412aa534ab62dbb8b0587618cc5",
      "audioDurationSeconds": 5.041633,
      "maxSeconds": 8
    },
    {
      "number": 10,
      "speaker": "Anlatıcı",
      "text": "Doğru maddeler, doğru oranlarda ve doğru koşullarda bir araya getirilir.",
      "chapter": "Aspirinin hikâyesi",
      "sourceScene": null,
      "sourceImage": "10.png",
      "imageFile": "gorseller/10-gorsel.jpg",
      "image": "gorseller/10-gorsel.jpg",
      "audioFile": "sesler/10-anlatici.mp3",
      "speechTextFile": "10-seslendirme.txt",
      "startFrame": 1259,
      "endFrame": 1408,
      "startSeconds": 41.96666666666667,
      "endSeconds": 46.93333333333333,
      "durationSeconds": 4.9666666666666615,
      "imageSha256": "fa529868b6f0c447b801672b4078b2d84b543b8168e825f5d590ac7343761a26",
      "audioDurationSeconds": 5.01551,
      "maxSeconds": 8
    },
    {
      "number": 11,
      "speaker": "Anlatıcı",
      "text": "Öğretmen gülümser: Aferin! Sizi sorgulayan insanlar olarak görmek istedim.",
      "chapter": "Sorgulayan öğrenciler",
      "sourceScene": null,
      "sourceImage": "11.png",
      "imageFile": "gorseller/11-gorsel.jpg",
      "image": "gorseller/11-gorsel.jpg",
      "audioFile": "sesler/11-anlatici.mp3",
      "speechTextFile": "11-seslendirme.txt",
      "startFrame": 1408,
      "endFrame": 1566,
      "startSeconds": 46.93333333333333,
      "endSeconds": 52.2,
      "durationSeconds": 5.266666666666673,
      "imageSha256": "e8f6109d662f66ffaa903f6838e0bd99802d6585da1270f52e0c344487f6273a",
      "audioDurationSeconds": 5.302857,
      "maxSeconds": 8
    },
    {
      "number": 12,
      "speaker": "Anlatıcı",
      "text": "Tek bir ilaç bile binlerce insanın bilgisini ve emeğini gerektirir.",
      "chapter": "Bilgi ve emek",
      "sourceScene": null,
      "sourceImage": "12.png",
      "imageFile": "gorseller/12-gorsel.jpg",
      "image": "gorseller/12-gorsel.jpg",
      "audioFile": "sesler/12-anlatici.mp3",
      "speechTextFile": "12-seslendirme.txt",
      "startFrame": 1566,
      "endFrame": 1704,
      "startSeconds": 52.2,
      "endSeconds": 56.8,
      "durationSeconds": 4.599999999999994,
      "imageSha256": "6cf13af3717f6fb63567f2662bdd74de5a9fb195798b4336b00a241ac77d2373",
      "audioDurationSeconds": 4.649796,
      "maxSeconds": 8
    },
    {
      "number": 13,
      "speaker": "Anlatıcı",
      "text": "Peki, bir aspirinden çok daha karmaşık olan insan?",
      "chapter": "Ya insan?",
      "sourceScene": null,
      "sourceImage": "13.png",
      "imageFile": "gorseller/13-gorsel.jpg",
      "image": "gorseller/13-gorsel.jpg",
      "audioFile": "sesler/13-anlatici.mp3",
      "speechTextFile": "13-seslendirme.txt",
      "startFrame": 1704,
      "endFrame": 1817,
      "startSeconds": 56.8,
      "endSeconds": 60.56666666666667,
      "durationSeconds": 3.766666666666673,
      "imageSha256": "2478ca8862e282d1e62b64ace759c302525ddb559d02609f411b84373005f521",
      "audioDurationSeconds": 3.813878,
      "maxSeconds": 8
    },
    {
      "number": 14,
      "speaker": "Anlatıcı",
      "text": "Bedenimizde trilyonlarca hücre, uyum içinde çalışır.",
      "chapter": "Ya insan?",
      "sourceScene": null,
      "sourceImage": "14.png",
      "imageFile": "gorseller/14-gorsel.jpg",
      "image": "gorseller/14-gorsel.jpg",
      "audioFile": "sesler/14-anlatici.mp3",
      "speechTextFile": "14-seslendirme.txt",
      "startFrame": 1817,
      "endFrame": 1930,
      "startSeconds": 60.56666666666667,
      "endSeconds": 64.33333333333333,
      "durationSeconds": 3.7666666666666586,
      "imageSha256": "574dee339090c2e70dbf4050fbe24bb5c458e8dfae7c84763199dd5f5c74373f",
      "audioDurationSeconds": 3.813878,
      "maxSeconds": 8
    },
    {
      "number": 15,
      "speaker": "Anlatıcı",
      "text": "İslam inancında bu düzen, her şeyi bilen ve gücü yeten Allah'ın yaratışına işaret eder.",
      "chapter": "Kâinattaki düzen",
      "sourceScene": null,
      "sourceImage": "15.png",
      "imageFile": "gorseller/15-gorsel.jpg",
      "image": "gorseller/15-gorsel.jpg",
      "audioFile": "sesler/15-anlatici.mp3",
      "speechTextFile": "15-seslendirme.txt",
      "startFrame": 1930,
      "endFrame": 2106,
      "startSeconds": 64.33333333333333,
      "endSeconds": 70.2,
      "durationSeconds": 5.866666666666674,
      "imageSha256": "d7f98395f456c035cdedf9f95b0cebebad5826a3f184a05e1655ca01c4a2ccc4",
      "audioDurationSeconds": 5.903673,
      "maxSeconds": 8
    },
    {
      "number": 16,
      "speaker": "Anlatıcı",
      "text": "Bir aspirin bile tesadüfle oluşmaz. Düşün, soru sor, araştır.",
      "chapter": "Mesaj",
      "sourceScene": null,
      "sourceImage": "16.png",
      "imageFile": "gorseller/16-gorsel.jpg",
      "image": "gorseller/16-gorsel.jpg",
